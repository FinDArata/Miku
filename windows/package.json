{
  "name": "miku-windows",
  "private": true,
  "version": "0.5.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "icons": "node scripts/gen-icons.mjs",
    "sounds": "node scripts/gen-sounds.mjs --style=chimes",
    "tauri": "tauri",
    "predev": "node scripts/gen-sounds.mjs --style=chimes && cargo build --release -p miku-hook",
    "prebuild": "node scripts/gen-sounds.mjs --style=chimes && cargo build --release -p miku-hook",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "pinyin-pro": "^3.29.5"
  }
}
